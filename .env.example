# ─── Banco (desenvolvimento local) ───────────────────────────────────────────
# Conexão do painel. Papel app_user: enxerga apenas a conta da sessão (RLS).
DATABASE_URL=postgres://app_user:troque-esta-senha@localhost:5432/painel_matrix

# Conexão do endpoint público de analytics. Papel app_ingest: SEM acesso a leads.
DATABASE_URL_INGEST=postgres://app_ingest:troque-esta-senha@localhost:5432/painel_matrix

# Conexão do endpoint público de formulários. Papel app_forms.
DATABASE_URL_FORMS=postgres://app_forms:troque-esta-senha@localhost:5432/painel_matrix

# Conexão administrativa, usada SOMENTE por scripts de migração e seed.
# Nunca é importada pelo código da aplicação.
DATABASE_URL_ADMIN=postgres://postgres@localhost:5432/painel_matrix

# ─── Sessão ──────────────────────────────────────────────────────────────────
# Segredo de assinatura do cookie de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ─── Aplicação ───────────────────────────────────────────────────────────────
# URL pública do painel. É o endpoint que aparece no snippet de instalação,
# então precisa ser alcançável pelos sites dos clientes.
APP_URL=http://localhost:3000

# Banco usado pelos testes automatizados. Isolado do de desenvolvimento.
TEST_DATABASE_NAME=painel_matrix_test

# ─── Produção (Supabase) ─────────────────────────────────────────────────────
# O mesmo SQL de supabase/migrations/ já está aplicado no projeto. Veja
# docs/deploy-supabase.md para os hosts e a criação dos papéis.
#
# DATABASE_URL=postgres://app_user:SENHA@HOST:5432/postgres
# DATABASE_URL_INGEST=postgres://app_ingest:SENHA@HOST:5432/postgres
# DATABASE_URL_FORMS=postgres://app_forms:SENHA@HOST:5432/postgres
#
# DATABASE_URL_ADMIN não é necessária em produção: só migração e seed a usam.

# Opcional: certificado raiz do provedor de banco, em PEM.
# Sem ele a conexão continua cifrada, mas o certificado do servidor não é
# verificado. Com ele, a cadeia é validada de verdade.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
