# ─── Banco (desenvolvimento local) ───────────────────────────────────────────
# Conexão do painel. Papel app_user: enxerga apenas a conta da sessão (RLS).
DATABASE_URL=postgres://app_user:troque-esta-senha@localhost:5432/painel_matrix

# Conexão do endpoint público de analytics. Papel app_ingest: SEM acesso a leads.
DATABASE_URL_INGEST=postgres://app_ingest:troque-esta-senha@localhost:5432/painel_matrix

# Conexão do endpoint público de formulários. Papel app_forms.
DATABASE_URL_FORMS=postgres://app_forms:troque-esta-senha@localhost:5432/painel_matrix

# Conexão administrativa, usada SOMENTE por scripts de migração e seed.
# Nunca é importada pelo código da aplicação.
DATABASE_URL_ADMIN=postgres://postgres@localhost:5432/painel_matrix

# ─── Sessão ──────────────────────────────────────────────────────────────────
# Segredo de assinatura do cookie de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# ─── Aplicação ───────────────────────────────────────────────────────────────
# URL pública do painel. É o endpoint que aparece no snippet de instalação,
# então precisa ser alcançável pelos sites dos clientes.
APP_URL=http://localhost:3000

# Banco usado pelos testes automatizados. Isolado do de desenvolvimento.
TEST_DATABASE_NAME=painel_matrix_test

# ─── Produção (Supabase) ─────────────────────────────────────────────────────
# O mesmo SQL de supabase/migrations/ já está aplicado no projeto. Veja
# docs/deploy-supabase.md para os hosts e a criação dos papéis.
#
# Use o host do POOLER, na porta 6543, e acrescente o sufixo do projeto ao nome
# do papel. Os dois detalhes são obrigatórios e falham de formas diferentes:
#
#   sem o sufixo .cihsheaiqinrmftjwexu → "Tenant or user not found"
#   na porta 5432 (conexão direta) → ETIMEDOUT, porque ela só resolve em IPv6
#
# O host exato está em Project Settings › Database › Connection string, aba
# "Transaction pooler".
#
# DATABASE_URL=postgres://app_user.cihsheaiqinrmftjwexu:SENHA@HOST-COPIADO-DO-CONNECT:6543/postgres
# DATABASE_URL_INGEST=postgres://app_ingest.cihsheaiqinrmftjwexu:SENHA@HOST-COPIADO-DO-CONNECT:6543/postgres
# DATABASE_URL_FORMS=postgres://app_forms.cihsheaiqinrmftjwexu:SENHA@HOST-COPIADO-DO-CONNECT:6543/postgres
#
# Só DATABASE_URL e SESSION_SECRET são necessárias para o painel subir. Sem as
# outras duas, os endpoints públicos de coleta e de formulários respondem 503 e
# o resto funciona.
#
# DATABASE_URL_ADMIN não é necessária em produção: só migração e seed a usam.

# Opcional: certificado raiz do provedor de banco, em PEM.
# Sem ele a conexão continua cifrada, mas o certificado do servidor não é
# verificado. Com ele, a cadeia é validada de verdade.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ─── Qualidade técnica (PageSpeed Insights + CrUX) ───────────────────────────
# Uma única chave do Google Cloud, com DUAS APIs habilitadas — são habilitadas
# separadamente, e ter a chave não basta:
#
#   1. PageSpeed Insights API
#   2. Chrome UX Report API      ← esquecer esta devolve 403 só no CrUX
#
# Crie em https://console.cloud.google.com/apis/credentials e restrinja o uso
# da chave. Sem esta variável, a análise técnica fica desligada e a tela diz
# isso — nunca exibe nota inventada.
#
# PAGESPEED_API_KEY=

# Segredo do agendador. A Vercel envia `Authorization: Bearer <valor>` nos
# crons, e os endpoints de auditoria só aceitam a chamada com ele. SEM esta
# variável os dois endpoints ficam FECHADOS — o padrão é negar, porque um
# agendador aberto enfileira análises de graça e queima a quota da conta.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# CRON_SECRET=

# Opcional: libera o detalhe de /api/diagnostico sem estar autenticado.
# Útil quando o banco não conecta e ninguém consegue entrar para investigar.
# DIAGNOSTIC_TOKEN=
